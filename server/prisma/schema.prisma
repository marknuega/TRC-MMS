generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A saved snapshot of the working entries, with a unique REP-#### series number.
model SavedReport {
  id            Int      @id @default(autoincrement())
  seq           Int      @unique // global insertion order (sorting + latest-per-date dedup)
  docNumber     Int      @default(0) @map("doc_number") // per-branch series number (REP-#### / TRANS-####)
  reportId      String   @map("report_id") // "REP-####"/"TRANS-####"; unique within a branch, not globally
  branch        String   @default("") // Makkah | Taif | Jeddah
  mode          String   @default("report") // report | transmittal
  transmittedBy String   @default("") @map("transmitted_by")
  receivedBy    String   @default("") @map("received_by")
  savedAt       DateTime @default(now()) @map("saved_at")
  dateLabel     String   @default("") @map("date_label")
  entryCount    Int      @default(0) @map("entry_count")
  entries       Json // snapshot of entries + faults, used to reload into the form

  @@unique([mode, branch, docNumber]) // each branch numbers its own series independently
  @@map("saved_reports")
}

// Spare-parts inventory. Avail is derived (begin - out), not stored.
model InventoryItem {
  id        Int      @id @default(autoincrement())
  sku       String   @unique
  branch    String   @default("") // owning branch; non-admins are scoped to their own
  store     String   @default("")
  shelf     String   @default("")
  itemCode  String   @default("") @map("item_code")
  begin     Int      @default(0)
  out       Int      @default(0)
  lowStock  Int      @default(0) @map("low_stock")
  remarks   String   @default("")
  txns      InventoryTxn[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([store])
  @@index([branch])
  @@map("inventory_items")
}

// A stock movement (ledger entry) for an inventory item.
model InventoryTxn {
  id         Int           @id @default(autoincrement())
  itemId     Int           @map("item_id")
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sku        String        @default("")
  type       String        @default("usage") // usage | adjustment
  change     Int           @default(0) // signed change to avail (negative = consumed)
  availAfter Int           @default(0) @map("avail_after")
  reference  String        @default("") // REP-#### / TRANS-#### / note
  branch     String        @default("")
  material   String        @default("")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([itemId])
  @@map("inventory_txns")
}

// Pasted/edited monthly activity matrix, per month + branch.
model MonthlySheet {
  id        Int      @id @default(autoincrement())
  monthKey  String   @map("month_key") // YYYY-MM
  branch    String   @default("")
  data      Json // { [day]: { counts, description } }
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([monthKey, branch])
  @@map("monthly_sheets")
}

// App user accounts. Admins see everything; users are scoped to their branch.
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("user") // admin | director | user
  branch       String   @default("")
  region       String   @default("") // set only for role=director — which AppOptions.data.regions key they run
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// A prospective user's request for login credentials (created in-app, no auth),
// reviewed by an admin.
model CredentialRequest {
  id        Int      @id @default(autoincrement())
  name      String
  branch    String   @default("")
  contact   String   @default("")
  note      String   @default("")
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now()) @map("created_at")

  @@map("credential_requests")
}

// Single-row (id=1) store for the user-managed dropdown option lists.
model AppOptions {
  id        Int      @id @default(1)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_options")
}

// Single-row (id=1) store for the CDS code map — the shared vocabulary that
// turns a short code like H43AC1MT into a part, action, company and technician.
// This app is now the home of that map; it is served publicly at GET /codemap
// in the same shape the WhatsApp bridge used to publish, so the bot only needs
// its URL repointed here. Kept as one JSON blob rather than tables because it
// is edited as a whole document and the bridge consumes it as a whole document.
model CodeMap {
  id        Int      @id @default(1)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("code_map")
}

// WhatsApp message ids (wamid) already acted on, so a retried webhook delivery
// of the same message is never processed twice.
//
// This MUST be durable storage. Meta has redelivered a message ~40 minutes
// after the original attempt (2026-08-08), and this service redeploys several
// times on a busy day — an in-memory guard forgets every id on each redeploy,
// so a retry landing afterwards files a duplicate report. The bot kept this on
// a Railway volume; this service has no volume, so it lives here instead.
//
// Rows are pruned after RETENTION_DAYS (see processedMessages.js) — Meta does
// not retry forever, and this table would otherwise grow without bound.
model ProcessedMessage {
  messageId   String   @id @map("message_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_messages")
}

// One report per date, holding the sequential REP-#### id shared by that day's entries.
model Report {
  id         Int      @id @default(autoincrement())
  reportDate DateTime @unique @map("report_date") @db.Date
  seq        Int      @unique // 1-based; renders as REP-0001, REP-0002, ...
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("reports")
}

// One entry = one device on a given report date, with up to 6 faults.
model ReportEntry {
  id         Int      @id @default(autoincrement())
  reportDate DateTime @map("report_date") @db.Date
  mode       String   @default("report") // report | transmittal — separate working sets
  branch     String   @default("") // owning branch; non-admins are scoped to their own
  technician String
  agency     String
  telNumber  String   @map("tel_number")
  issiNumber String   @map("issi_number")
  type       String
  model      String
  comment    String   @default("")
  faults     Fault[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([reportDate])
  @@index([mode])
  @@index([branch])
  @@map("report_entries")
}

// A single fault on a device. Max 6 per entry is enforced in the API.
model Fault {
  id       Int         @id @default(autoincrement())
  entryId  Int         @map("entry_id")
  entry    ReportEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position Int         @default(0) // 0-5, preserves the order faults were entered
  issue    String
  quantity Int         @default(1)
  action   String // CHANGE|REPAIR|NEW|PCB|PROGRAM|RE-PROGRAM|INSTALL|RE-INSTALL|DISMANTLE
  company  String   @default("") // MOTECO|MOI|PROJECT 2|PROJECT X|ONLINE|MOTECO LOCAL|FREE
  status   String   @default("") // transmittal item status: New | Refurbish

  @@index([entryId])
  @@map("faults")
}
