# Copy this file to .env and fill in real values. NEVER commit .env.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/trc_daily_report"
PORT=3000
NODE_ENV=development

# Signs the session cookie. The server refuses to boot without it — there is no
# fallback, because a default secret means anyone can forge an admin session.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Only used on a database with no admin yet (first boot). Leave blank and the
# server generates a random password and prints it once in the boot log.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
